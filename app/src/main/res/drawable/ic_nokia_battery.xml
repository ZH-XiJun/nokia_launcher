<?xml version="1.0" encoding="utf-8"?>
<!-- 启动占位电池（满电 4 格，与 ic_battery_100 风格一致） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 电池外框（仅描边） -->
    <item android:width="15dp" android:height="9dp" android:gravity="center_vertical|left">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FFFFFF"/>
            <corners android:radius="1dp"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <!-- 第 1 格 -->
    <item android:width="2dp" android:height="5dp" android:gravity="top|left" android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#4CAF50"/></shape>
    </item>
    <!-- 第 2 格 -->
    <item android:width="2dp" android:height="5dp" android:gravity="top|left" android:left="5dp" android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#4CAF50"/></shape>
    </item>
    <!-- 第 3 格 -->
    <item android:width="2dp" android:height="5dp" android:gravity="top|left" android:left="8dp" android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#4CAF50"/></shape>
    </item>
    <!-- 第 4 格 -->
    <item android:width="2dp" android:height="5dp" android:gravity="top|left" android:left="11dp" android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#4CAF50"/></shape>
    </item>
    <!-- 电池帽 -->
    <item android:width="3dp" android:height="5dp" android:gravity="top|left" android:left="15dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>
