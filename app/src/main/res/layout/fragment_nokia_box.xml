<?xml version="1.0" encoding="utf-8"?>
<!-- 应用程序中间内容（碎片）：240dp 宽 × 262dp 高，由基类缩放。
     262dp = 320 - 36 - 22，正好填满中间容器不被裁切。
     ScrollView 内为 LinearLayout 容器，由 Java 代码动态添加网格/次级菜单。
     外层 FrameLayout 承载选项菜单覆盖层（应用内 overlay，替代 Dialog 独立窗口）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/boxRoot"
    android:layout_width="240dp"
    android:layout_height="262dp">

    <ScrollView
        android:id="@+id/appScroll"
        android:layout_width="240dp"
        android:layout_height="262dp"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/appContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp" />

    </ScrollView>

    <!-- 选项菜单覆盖层：铺满整个碎片区域并拦截触摸，面板内容复用 dialog_nokia_app_options.xml。
         按键不经过独立 Dialog 窗口，直接走 Activity.dispatchKeyEvent -> NokiaFocusHost，
         从而避免 Android 13 上 Dialog 窗口首个方向键被触摸模式吞掉的问题。 -->
    <FrameLayout
        android:id="@+id/optionsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

</FrameLayout>
