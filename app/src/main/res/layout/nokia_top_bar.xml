<?xml version="1.0" encoding="utf-8"?>
<!-- 共用的诺基亚顶部状态栏：三页复用。
     注意：顶栏由基类以"原生分辨率"渲染（不做 setScaleX 缩放），以保证矢量图标清晰不模糊；
     仅高度按设计比例(18dp*scale)放大，由代码设置。内层宽度铺满屏幕。
     左侧图标簇：SIM1 信号 / SIM2 信号 / 电池 / WiFi / 蓝牙 / 飞行模式（后三项按需显示）。
     标题(topTitle)由每个页面在运行时设置。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="invisible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- 左侧图标簇：双卡信号 + 电池 + WiFi + 蓝牙 + 飞行模式 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- SIM1 信号 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivSignal1"
                    android:layout_width="20dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_signal_0" />
            </LinearLayout>

            <!-- SIM2 信号 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivSignal2"
                    android:layout_width="20dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_signal_0" />
            </LinearLayout>

            <!-- 电池（保持不变） -->
            <ImageView
                android:id="@+id/ivBattery"
                android:layout_width="24dp"
                android:layout_height="13dp"
                android:layout_marginStart="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nokia_battery" />

            <!-- WiFi（开启时显示） -->
            <ImageView
                android:id="@+id/ivWifi"
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:layout_marginStart="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nokia_wifi"
                android:visibility="gone" />

            <!-- 蓝牙（开启时显示） -->
            <ImageView
                android:id="@+id/ivBluetooth"
                android:layout_width="18dp"
                android:layout_height="15dp"
                android:layout_marginStart="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nokia_bluetooth"
                android:visibility="gone" />

            <!-- 飞行模式（开启时显示） -->
            <ImageView
                android:id="@+id/ivAirplane"
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:layout_marginStart="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nokia_airplane"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/topTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:55"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
