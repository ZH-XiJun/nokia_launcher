<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面待机屏中间内容（碎片）：240dp 宽 × 280dp 高，由基类缩放。
     运营商名(中国移动/联通等)已迁到 nokia_top_bar.xml，由 StatusBarController 统一管理。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="280dp">

    <!-- 快捷栏上方的点线分割线 -->
    <View
        android:id="@+id/shortcutDividerTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_nokia_divider_dashed" />

    <HorizontalScrollView
        android:id="@+id/shortcutBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/shortcutDividerTop"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/shortcutContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <!-- 选中快捷应用时，在图标正上方浮出的名称气泡 -->
    <TextView
        android:id="@+id/shortcutNameBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="0dp"
        android:background="@drawable/bg_nokia_bubble"
        android:gravity="center"
        android:maxWidth="200dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- 快捷栏与通知区之间的点线分割线 -->
    <View
        android:id="@+id/shortcutDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/shortcutBar"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_nokia_divider_dashed" />

    <LinearLayout
        android:id="@+id/notificationArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/shortcutDivider"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/notifMusic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="♪"
                android:textColor="#f44336"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="音乐播放器"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notifRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_nokia_web" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3g.qq.com"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notifLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_nokia_lock" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="锁屏"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notifCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="12dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_nokia_cal_small" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="星期一 2026-07-27"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:text="无更多备忘"
            android:textColor="#888888"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="10dp"
        android:alpha="0.15"
        android:src="@drawable/deco_rings" />
</RelativeLayout>
