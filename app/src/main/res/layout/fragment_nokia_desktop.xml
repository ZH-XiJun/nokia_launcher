<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面待机屏中间内容（碎片）：240dp 宽，高度 match_parent 自适应中间容器。
     顶栏与快捷栏（含上下点线）位置固定优先保障；通知/组件区填充剩余空间，
     允许被挤压（后续会做可滚动）。基类缩放不再触发二次缩小分支。
     运营商名(中国移动/联通等)已迁到 nokia_top_bar.xml，由 StatusBarController 统一管理。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="match_parent">

    <!-- 桌面组件区：从顶部开始填充（快捷栏已移到 Activity 级底栏上方），
         动态渲染用户添加的组件，允许被挤压（后续会做可滚动）。 -->
    <LinearLayout
        android:id="@+id/notificationArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp" />


    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="10dp"
        android:alpha="0.15"
        app:srcCompat="@drawable/deco_rings" />
</RelativeLayout>
